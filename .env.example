APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai
# 宿主机运行 Python / Alembic 时连接的外部 PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:password@your-pg-host:5432/stock_db
# Docker 容器连接同一外部 PostgreSQL；地址必须可从容器访问
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:password@your-pg-host:5432/stock_db
TUSHARE_TOKEN=replace_me
TUSHARE_HTTP_URL=https://fastapic.stockai888.top
TUSHARE_MIN_INTERVAL_SECONDS=1.5
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=123456
AUTH_SESSION_HOURS=168
AUTH_COOKIE_SECURE=false
AUTH_LAST_SEEN_UPDATE_MINUTES=10
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCKOUT_SECONDS=60
REALTIME_KLINE_CACHE_SECONDS=120
REALTIME_KLINE_NEGATIVE_CACHE_SECONDS=1800
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=5173
# 智能研究 Chat 默认关闭。启用 EAS 时设置 LLM_ENABLED=true，并填写下列四项。
# LLM_ENDPOINT 是基础地址，末尾保留 /v1；优先使用 HTTPS 公网或 VPC 地址。
# LLM_MODEL 使用 EAS /v1/models 返回的模型 ID；EAS 鉴权方式使用 raw。
# 不要将真实 Token 写入此模板或提交到 Git。已公开的 Token 应先在 EAS 重置。
LLM_ENABLED=false
# LLM_ENDPOINT=https://your-eas-host.pai-eas.aliyuncs.com/api/predict/your-service/v1
# LLM_MODEL=your-model-id
# LLM_AUTH_SCHEME=raw
LLM_API_KEY=
# 兼容原有 OpenAI 配置：未设置 LLM_API_KEY 时按 config/agent.yaml 的 api_key_env 读取。
OPENAI_API_KEY=
