# 空间环境变量模板：复制为项目根目录的 .env 后填写，不要覆盖已有的真实配置。
# 本文件中的数据库地址、密码和 Token 都是占位值，不能直接用于启动服务。
# 真实密码、Token 仅填写在 .env；不要提交到 Git、截图或粘贴到聊天中。
# 修改 .env 后需重启对应进程；Docker 需重新创建容器，单纯 restart 不会加载新环境变量。
# 策略、定时任务、PAPER 与归档开关另见 config/*.yaml，并非都由 .env 控制。

# ==================== 1. 运行环境 ====================
# 运行环境：本地开发用 dev；正式部署用 prod。
# prod 会检查初始化管理员密码至少 12 位、非默认值，并要求 AUTH_COOKIE_SECURE=true。
# 这些检查不是完整的安全部署；生产还需 HTTPS、访问控制和备份。
APP_ENV=dev
# V1.4 新 A/B 读路径待隔离性能门禁审阅，默认关闭；不控制公式或历史复用。
AB_MERGE_READ_ENABLED=false

# 业务日期和定时任务使用的时区，通常保持 Asia/Shanghai，不要改成服务器所在时区。
# 注意：当前 config/app.yaml 的 app.timezone 优先于这里的值；Docker 的 TZ 也单独设置。
APP_TIMEZONE=Asia/Shanghai

# ==================== 2. PostgreSQL 连接 ====================
# 本地运行 Python、API、Worker 或 Alembic 时使用的连接串，必须替换用户名、密码、地址和库名。
# 格式：postgresql+psycopg://用户名:密码@地址:端口/数据库名；数据库基线为 PostgreSQL 17。
# 密码中的 @、#、%、/ 等特殊字符需进行 URL 编码；云数据库要求 SSL 时按其要求添加参数。
# 例如要求 SSL 时，在连接串末尾添加 ?sslmode=require。
DATABASE_URL=postgresql+psycopg://postgres:password@your-pg-host:5432/stock_db

# 仅 Docker Compose 使用：会覆盖容器中的 DATABASE_URL；与上面指向同一业务数据库。
# 云数据库通常两项填相同值；此处地址必须能从容器访问，127.0.0.1 指的是容器自己。
# Compose 不提供 PostgreSQL，也不会自动创建连接串中指定的数据库；迁移只负责升级表结构。
DOCKER_DATABASE_URL=postgresql+psycopg://postgres:password@your-pg-host:5432/stock_db

# ==================== 3. Tushare 数据源 ====================
# 数据拉取必填：填写与你使用的接口地址匹配的 Token，replace_me 不能直接使用。
# 当前默认地址是代理服务，需要代理管理员提供的 Token，不一定能使用官方 Token。
TUSHARE_TOKEN=replace_me

# Tushare API 地址，不是 HTTP_PROXY/HTTPS_PROXY 网络代理；当前为项目使用的代理 API。
# 使用官方服务时填写官方 API 地址；不要将官方 Token 和第三方代理地址混用。
TUSHARE_HTTP_URL=https://fastapic.stockai888.top

# 同一个 Python 进程内，Tushare 请求开始时间的最小间隔，单位秒；默认 1.5 秒。
# 调大可降低请求频率，但拉取会更慢；不是跨 API/Worker 进程的全局限流，仍需遵守源端限额。
TUSHARE_MIN_INTERVAL_SECONDS=1.5

# ==================== 4. 后端监听与日志 ====================
# 后端地址配置字段，127.0.0.1 表示仅本机；当前 Uvicorn 启动命令显式指定 --host。
# 只改本项不会改变 README/Compose 命令的监听地址，应以实际启动命令为准。
API_HOST=127.0.0.1

# 后端端口配置字段；当前 Uvicorn 命令显式指定 --port，不能只改本项来切换端口。
# 本地常用 --port 9034；Compose 内部固定 8000，宿主机映射为 127.0.0.1:9034。
API_PORT=8000

# CLI/Worker 等使用的应用日志级别，常用 DEBUG、INFO、WARNING、ERROR；默认 INFO。
# Uvicorn 自身访问日志的级别由其启动参数控制，不会自动跟随本项。
LOG_LEVEL=INFO

# ==================== 5. 管理员初始化与登录安全 ====================
# API 启动时，仅在该用户名不存在的情况下创建管理员；默认用户名 admin。
# 已存在的账号不会因修改这里的用户名或密码而被重置。
BOOTSTRAP_ADMIN_USERNAME=admin

# 新管理员的初始密码；123456 仅为开发示例，首次登录必须修改密码。
# 正式部署必须在 .env 中换成至少 12 位的强密码，不能使用此默认值。
# 忘记已有账号密码时需使用项目提供的密码重置流程，修改本项无效。
BOOTSTRAP_ADMIN_PASSWORD=123456

# 登录会话有效期，单位小时；默认 168 小时即 7 天，修改只影响之后创建的会话。
AUTH_SESSION_HOURS=168

# 是否仅允许浏览器通过 HTTPS 发送登录 Cookie：本地 HTTP 开发用 false。
# 正式 HTTPS 部署必须用 true；普通服务器 IP 的 HTTP 访问不能直接照搬生产配置。
# 开启后需通过 HTTPS 登录，否则后续接口可能因没有携带 Cookie 而显示未登录。
AUTH_COOKIE_SECURE=false

# 已登录会话的 last_seen_at 最小数据库更新间隔，单位分钟，必须大于 0。
# 默认 10 分钟，用于减少每次接口请求都写数据库；不是会话过期时间。
AUTH_LAST_SEEN_UPDATE_MINUTES=10

# 同一用户名和客户端 IP 的登录失败统计窗口，单位秒，必须大于 0；默认 300 秒即 5 分钟。
# 当前失败计数保存在单个 API 进程内，不是多进程共享的安全网关。
AUTH_LOGIN_FAILURE_WINDOW_SECONDS=300

# 上述窗口内允许达到的失败次数阈值，必须大于 0；默认第 5 次失败后进入临时锁定。
AUTH_LOGIN_MAX_FAILURES=5

# 达到阈值后的登录锁定时长，单位秒，必须大于 0；默认 60 秒。
AUTH_LOGIN_LOCKOUT_SECONDS=60

# ==================== 6. 实时 K 线缓存 ====================
# 实时 K 线接口对 Provider 非空响应的进程内缓存时长，单位秒；默认 120 秒。
# 只影响实时查询缓存，不改变 Raw 表或历史拉取结果；0 关闭这一类缓存。
REALTIME_KLINE_CACHE_SECONDS=120

# Provider 空响应的进程内缓存时长，单位秒；默认 1800 秒即 30 分钟，避免重复查无数据区间。
# 临近最新行情的空结果会缩短缓存时间；0 关闭空响应缓存。两项都为 0 才完全关闭此缓存。
REALTIME_KLINE_NEGATIVE_CACHE_SECONDS=1800

# ==================== 7. Docker 网页访问 ====================
# 仅控制 Compose 前端端口发布到宿主机的哪个地址，不影响 npm run dev。
# 127.0.0.1：只允许服务器本机访问，适合前置同机 HTTPS 反向代理。
# 0.0.0.0：允许通过服务器 IP 访问，还需防火墙/云安全组放行 FRONTEND_PORT。
# 对外开放应限制来源 IP，并配置 HTTPS、强密码；无需开放后端 9034 端口。
FRONTEND_BIND=127.0.0.1

# Docker 网页对外端口，容器内 Nginx 仍为 80；默认网页为 http://宿主机地址:5173。
# 改为其他空闲端口后，浏览器地址和防火墙规则也要对应修改。
# 后端已正常运行时，仅更新网页绑定可执行：docker compose up -d --no-deps frontend。
FRONTEND_PORT=5173

# ==================== 8. 可选 LLM 研究对话 ====================
# 是否启用智能研究对话的模型编排：默认 false，不用 LLM 时下面密钥可留空。
# 不影响普通数据拉取、因子计算；启用也不授予模型下单、修改策略或触发计算的权限。
# 更多能力开关与调用预算见 config/agent.yaml；PAPER 自动运行由独立配置控制。
LLM_ENABLED=false

# 模型服务的兼容接口基础地址，通常以 /v1 结尾，不要填写完整 /chat/completions 路径。
# 启用时取消下面这一行的注释并替换地址；优先使用 HTTPS 或受保护的内网连接。
# EAS 示例不包含真实服务地址；应以你部署的兼容接口实际路径为准。
# LLM_ENDPOINT=https://your-eas-host.pai-eas.aliyuncs.com/api/predict/your-service/v1

# 模型标识，必须与服务支持的模型 ID 一致；不是网页上随意填写的显示名称。
# 启用时取消注释并填写；EAS 可通过该服务 /v1/models 返回的 ID 核对。
# LLM_MODEL=your-model-id

# Authorization 请求头格式：raw 直接发送密钥，bearer 发送 Bearer 加空格再加密钥。
# 当前使用的 EAS 配置采用 raw；默认兼容服务配置为 bearer，按实际服务要求选择。
# LLM_AUTH_SCHEME=raw

# 模型服务密钥，优先于下方兼容密钥读取；填写在 .env 中，不要在本模板放真实值。
# 启用模型对话时需要可用密钥；已公开的密钥应在服务端作废并重新生成。
LLM_API_KEY=

# 兼容旧配置的备用密钥；仅当 LLM_API_KEY 为空时，按 config/agent.yaml 的 llm.api_key_env 读取。
# 该配置默认指向 OPENAI_API_KEY；使用上面的 LLM_API_KEY 时，此项可留空，无需填写两份。
OPENAI_API_KEY=
