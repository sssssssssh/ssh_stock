ARG BUILDER_IMAGE
ARG PG17_BASE
FROM ${BUILDER_IMAGE} AS compiler
WORKDIR /src
COPY bootstrap.c /src/bootstrap.c
RUN cc -std=c17 -O2 -Wall -Wextra -Werror -D_FORTIFY_SOURCE=2 -fstack-protector-strong -Wl,-z,relro,-z,now -o /src/bootstrap-native /src/bootstrap.c
FROM ${PG17_BASE}
COPY --from=compiler --chown=0:0 --chmod=0555 /src/bootstrap-native /usr/local/libexec/space-g1-pg17-bootstrap-native
COPY --chown=0:0 --chmod=0555 bootstrap.sh /usr/local/libexec/space-g1-pg17-bootstrap
COPY --chown=0:0 --chmod=0555 healthcheck.sh /usr/local/libexec/space-g1-pg17-healthcheck
COPY --chown=0:0 --chmod=0444 pg_hba.template /usr/local/share/space-g1/pg_hba.template
USER 999:999
WORKDIR /
ENTRYPOINT ["/usr/local/libexec/space-g1-pg17-bootstrap"]
