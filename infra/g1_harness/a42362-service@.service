[Unit]
Description=Space G1 isolated %i source-review service (NOT AUTHORIZED)
Requires=a42362-socket@%i.socket
After=a42362-socket@%i.socket

[Service]
Type=exec
User=space-g1-%i
Group=space-g1-%i
ExecStart=/opt/space-g1/python -I /opt/space-g1/scripts/a42362_service_host.py
